# TMDB credentials (v3 API key or v4 read access token)
REACT_APP_TMDB_API_KEY=your_tmdb_api_key_here

# Supabase (optional). Leave blank to run fully local-only — the app still
# works with localStorage-only persistence and no login. Fill both in to
# enable email/password accounts + cross-device sync. See README.md and
# supabase/schema.sql for setup.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
